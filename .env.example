# Database
DATABASE_URL="file:./dev.db"

# Session
SESSION_SECRET="replace_with_long_random_secret"
SESSION_DAYS="15"

# Aliyun SMS
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""

# Aliyun Mail (SMTP)
ALIYUN_SMTP_HOST="smtpdm.aliyun.com"
ALIYUN_SMTP_PORT="465"
ALIYUN_SMTP_USER=""
ALIYUN_SMTP_PASS=""
ALIYUN_SMTP_FROM="有厚米科技 <no-reply@yohomie.cn>"

# Alipay (电脑网站支付)
ALIPAY_APP_ID=""
# 多行密钥请使用 \n 转义，或在部署平台使用多行 Secret
ALIPAY_PRIVATE_KEY=""
ALIPAY_PUBLIC_KEY=""
ALIPAY_GATEWAY="https://openapi.alipay.com/gateway.do"
ALIPAY_NOTIFY_URL="https://yohomie.cn/api/pay/alipay/notify"
ALIPAY_RETURN_URL="https://yohomie.cn/pay/result"

# 可选：Java 侧签名下单。设置后 /api/pay/create 会 POST 到 ${PAY_JAVA_BASE_URL}/pay/create，
# 不再使用本机 Node alipay-sdk 签名（避免 OpenSSL DECODER 等问题）。仅需配置下方回调 URL，可不配私钥。
# PAY_JAVA_BASE_URL="http://127.0.0.1:18080"
